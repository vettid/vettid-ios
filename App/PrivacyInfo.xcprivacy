<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's privacy manifest. No tracking. The required-reason APIs the app and its packages use:
     UserDefaults for the app's own settings (the theme, App/VettIDApp.swift, VettIDData ThemeSetting; cleared by the
     wipe, App/Composition/AppWipeTargets.swift): CA92.1. File metadata of files in the app's own container: the size
     of a state file (fstat, VettIDKeys EncryptedFileStore; libsodium also imports fstat) and the age of copied-in canary manifests
     (App/CanaryManifestFiles.swift): C617.1. The collected data types are left to the App Privacy answers in App Store
     Connect, which the owner gives. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
