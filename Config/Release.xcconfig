// Release configuration: VettID (IOS-PLAN §5 "Build configurations").
#include "Base.xcconfig"

VETTID_APP_BUNDLE_ID = com.vettid.app
VETTID_APP_ICON = AppIcon
VETTID_DISPLAY_NAME = VettID
VETTID_ENVIRONMENT = production
VETTID_ACCOUNT_HOST = account.vettid.org
VETTID_RELAY_HOST = relay.vettid.org
VETTID_MANIFEST_HOST = vettid.org
// Release pins only the production manifest keys, in code (VettIDAttestation's ManifestKeys).
VETTID_MANIFEST_KEYS =
