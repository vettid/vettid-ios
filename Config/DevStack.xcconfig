// DevStack configuration: VettID Dev Stack (IOS-PLAN §5 "Build configurations").
#include "Base.xcconfig"

VETTID_APP_BUNDLE_ID = com.vettid.app.devstack
VETTID_DISPLAY_NAME = VettID Dev Stack
VETTID_ENVIRONMENT = devstack
VETTID_ACCOUNT_HOST = 127.0.0.1:18081
VETTID_RELAY_HOST = relay.vettid.test
VETTID_MANIFEST_HOST = 127.0.0.1:18081
// The dev stack's TEST-ONLY manifest key and Nitro root come from its control port (I1.3).
VETTID_MANIFEST_KEYS =

// DEVELOPMENT ONLY: the local dev stack's member API (vettid-vault
// cmd/devstack). The release check refuses this address in Release and
// Staging builds.
