    "ios_app_lock_enable_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app lock cannot be used on this iPhone (it needs Face ID, Touch ID or a passcode)."
          }
        }
      }
    },
    "ios_app_lock_use_passcode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID and Touch ID are not set up on this iPhone. Choose iPhone passcode under Unlock with to use the app lock with the passcode."
          }
        }
      }
    },
    "ios_settings_app_screenshots_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots will show whatever is on screen, including messages and vault items. Anyone you show or send them to sees the same. Screen recording and sharing stay hidden, and the app switcher still shows only the VettID cover.\n\nThis turns itself off when the vault locks, and after 1 hour. The screen for typing a recovery code stays protected."
          }
        }
      }
    },
    "ios_settings_app_screenshots_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Screens that hold your secrets are left out of screenshots."
          }
        }
      }
    },
    "ios_settings_attestation_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault checks this iPhone's App Attest key at every enrollment and unlock, and this iPhone checks the vault's enclave against VettID's signed release list."
          }
        }
      }
    },
    "ios_settings_attestation_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone"
