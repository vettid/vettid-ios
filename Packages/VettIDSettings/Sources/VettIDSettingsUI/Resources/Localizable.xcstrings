      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What every connection sees of you: the name on your VettID account and your vault key, always; a display name and the items you tag @profile, if you add them."
          }
        }
      }
    },
    "settings_profile_items": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every connection sees these items, with all of their fields, as part of your profile. Only standard items can be added."
          }
        }
      }
    },
