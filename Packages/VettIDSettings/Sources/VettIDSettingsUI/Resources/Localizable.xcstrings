{
  "sourceLanguage": "en",
  "strings": {
    "canary_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use it"
          }
        }
      }
    },
    "canary_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is a list of vault releases signed by VettID (serial %lld, key %@) that VettID has not published yet. It lists %@. Use it only if VettID asked you to test a new vault release. The app uses it instead of the published list until VettID publishes this list or a newer one."
          }
        }
      }
    },
    "canary_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a test release manifest?"
          }
        }
      }
    },
    "canary_installed_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app now uses the test release manifest (serial %lld). You can stop using it in Settings, Attestation."
          }
        }
      }
    },
    "canary_installed_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test release manifest in use"
          }
        }
      }
    },
    "canary_ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "canary_refused_format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not a VettID release manifest."
          }
        }
      }
    },
    "canary_refused_older": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is older than the release list this phone already uses."
          }
        }
      }
    },
    "canary_refused_other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It could not be checked. Try again."
          }
        }
      }
    },
    "canary_refused_published": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID has already published this release list or a newer one, so it is not needed."
          }
        }
      }
    },
    "canary_refused_signature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not signed with a key this app trusts."
          }
        }
      }
    },
    "canary_refused_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be used"
          }
        }
      }
    },
    "canary_release": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "release %lld (%@)"
          }
        }
      }
    },
    "credential_alarm_card_frozen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another copy of your credential was presented. Credential use is frozen until you answer."
          }
        }
      }
    },
    "credential_alarm_card_rotate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate your credential to end the alert."
          }
        }
      }
    },
    "credential_alarm_card_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credential alert"
          }
        }
      }
    },
    "credential_backup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sealed backup"
          }
        }
      }
    },
    "credential_backup_off_ack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand that without this phone my vault cannot be recovered"
          }
        }
      }
    },
    "credential_backup_off_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this phone is lost, broken, reset or replaced without a transfer, your vault <b>cannot be recovered</b>. It can only be deleted and replaced by a new one, and <b>everything in it is lost</b>."
          }
        }
      }
    },
    "credential_backup_off_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off"
          }
        }
      }
    },
    "credential_backup_off_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sealed backup is off."
          }
        }
      }
    },
    "credential_backup_off_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recovery: if this phone is lost, broken, reset or replaced without a transfer, your vault cannot be recovered."
          }
        }
      }
    },
    "credential_backup_off_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the sealed backup off?"
          }
        }
      }
    },
    "credential_backup_on_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is on. Confirm with your PIN and password now: recovery is possible from then on."
          }
        }
      }
    },
    "credential_backup_supporting_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recovery: only this phone holds your credential"
          }
        }
      }
    },
    "credential_backup_supporting_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault keeps a sealed copy for recovery"
