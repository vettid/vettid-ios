    "settings_transfer_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to a new phone"
          }
        }
      }
    },
    "settings_transfer_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move VettID to a new phone: your credential moves there, and your vault and your connections then work with the new phone. This phone then erases VettID and keeps nothing of it."
          }
        }
      }
    },
    "settings_transfer_steps_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        }
      }
    },
    "settings_transfer_steps_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. On the new phone, install VettID, choose Move from my old phone and sign in to your account.\n2. Show the code here and scan it with the new phone.\n3. Check that both phones show the same 6 digits, then approve here with your vault PIN and credential password."
          }
        }
      }
    },
    "settings_transfer_lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost your old phone instead? Start a recovery on the account site."
          }
        }
      }
    },
