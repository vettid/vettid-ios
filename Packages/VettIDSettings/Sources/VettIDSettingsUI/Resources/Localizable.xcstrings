      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the move on your new phone. This phone keeps your vault's keys until your new phone has finished the move, and until your vault has confirmed it. Once your new phone works, you can remove VettID from this phone. Before you give this phone away, remove VettID from it or reset it."
          }
