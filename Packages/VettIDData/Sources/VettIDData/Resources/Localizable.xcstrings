        }
      }
    },
    "data_failure_attestation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone could not be verified. VettID needs a phone with hardware key attestation and a locked, verified boot."
          }
        }
      }
    },
    "data_failure_backoff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many wrong attempts. Wait before trying again."
