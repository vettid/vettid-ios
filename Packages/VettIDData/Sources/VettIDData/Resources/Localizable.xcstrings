    "data_failure_no_vault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID's account service says that your account has no vault. That is what it says after a vault was deleted or an account closed, and it can also be a fault of the service. If you did not delete your vault, do not start over: try again later."
          }
        }
      }
    },
    "data_failure_not_found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
