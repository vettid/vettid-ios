            "value": "Rejected on your phone."
          }
        }
      }
    },
    "data_failure_release_ended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault software release your vault is sealed to has ended. The vault can no longer be opened."
          }
        }
      }
    },
    "data_failure_release_too_old": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vault's release is too old for the iPhone app. It will be updated soon; try again later."
          }
        }
      }
    },
    "data_failure_release_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault runs a release that is not in this app's list of vault releases, so VettID did not ask for your PIN and sent nothing. The app loads the list again each time you try. Try again; if this keeps happening, update VettID."
          }
        }
      }
    },
    "data_failure_renew_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID couldn't confirm your last new phone secret. Before you change your PIN, lock your vault and unlock it again: your PIN hasn't changed, so this doesn't use an attempt."
          }
        }
      }
    },
    "data_failure_response_too_large": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault's answer was too large to send to this phone. Nothing was changed. Try again later."
          }
        }
      }
    },
