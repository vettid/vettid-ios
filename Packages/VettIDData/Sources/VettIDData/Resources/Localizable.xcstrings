    "data_recovery_unknown_day": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a day your vault has not been able to check its recovery attempts or record that you were here. If this goes on for three days, your vault is no longer protected against a recovery started by someone else, and until it ends you cannot change your PIN or password. This is a fault of the VettID service or an attack on it. Contact VettID."
          }
        }
      }
    },
