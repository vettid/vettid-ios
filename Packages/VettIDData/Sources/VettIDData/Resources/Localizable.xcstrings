    "data_failure_busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is busy right now. Nothing was used or changed. Try again in a minute."
          }
        }
      }
    },
    "data_failure_capability_rollback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vault's software is older than the software this phone last used with it. Contact VettID."
          }
        }
      }
    },
    "data_failure_change_undecided": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID is still checking whether your last PIN change went through. This can take up to about 10 minutes. Try again then."
          }
        }
      }
    },
    "data_failure_change_undecided_password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID is still checking whether your last password change went through. This can take up to about 10 minutes. Try again then."
          }
        }
      }
    },
    "data_failure_change_undecided_reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID is still checking whether your new credential was made. This can take up to about 10 minutes. Try again then."
          }
        }
      }
    },
    "data_failure_change_unresolved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID is still checking whether your last change went through. Try again when your vault can be reached."
          }
        }
      }
    },
    "data_failure_clock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID's account service refused this phone's requests because the phone's date and time are more than a few minutes off. Turn on automatic date and time in the phone's settings, then try again."
          }
        }
      }
    },
    "data_failure_conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changed on another device. Look again and retry."
          }
        }
      }
    },
    "data_failure_connection_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection cannot be reached right now. Try again later."
          }
        }
      }
    },
    "data_failure_counter_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot check the attempt record now. Nothing was used or changed. Try again later."
          }
        }
      }
    },
    "data_failure_credential_locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your credential is locked. Enter your credential password to continue."
          }
        }
      }
    },
    "data_failure_credential_unsettled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID is still finishing an earlier request to your vault. Nothing was changed. Try again in a minute."
          }
        }
      }
    },
    "data_failure_device_secret": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone no longer holds the keys of your vault. That happens when the app's data was cleared or the phone was set up again from a backup. Nothing was disclosed. Whether you can get back into the vault depends on one of its settings. If its credential backup was on (the usual case), you can recover it: start a recovery on the account site. It takes one to three days, and you need your PIN and your password. If you had turned credential backup off, this vault cannot be brought back; you can delete it on the account site and start a new one. If you still have a phone on which VettID works, use 'Move to a new phone' there instead. The account site tells you which of these applies."
          }
        }
      }
    },
    "data_failure_device_secret_scaled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone no longer holds the keys of your vault. That happens when the app's data was cleared or the phone was set up again from a backup. Nothing was disclosed. Whether you can get back into the vault depends on one of its settings. If its credential backup was on (the usual case), you can recover it: start a recovery on the account site. It takes %1$@ to %2$@, and you need your PIN and your password. If you had turned credential backup off, this vault cannot be brought back; you can delete it on the account site and start a new one. If you still have a phone on which VettID works, use 'Move to a new phone' there instead. The account site tells you which of these applies."
          }
        }
      }
    },
    "data_failure_enclave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault's software could not be verified. Nothing was sent to it: not your PIN, nor anything else. Try again; if this keeps happening, do not enter your PIN anywhere else and contact VettID support."
          }
        }
      }
    },
    "data_failure_erase_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID could not remove your vault's keys from this phone. Try again. If it keeps failing, erase VettID's data on this phone. Your vault itself is not affected: afterwards you can set VettID up again or recover your vault from your account."
          }
        }
      }
    },
    "data_failure_frozen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your credential is frozen after a clone alert. Answer the alert first."
          }
        }
      }
    },
    "data_failure_hardware_keys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone cannot keep your vault's keys in its secure hardware."
          }
        }
      }
    },
    "data_failure_in_use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sharing rule uses this tag. Change or delete the rule first."
          }
        }
      }
    },
    "data_failure_invite_expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation has expired. Ask for a new one."
