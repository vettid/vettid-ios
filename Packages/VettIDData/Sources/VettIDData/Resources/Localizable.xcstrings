      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invitation is no longer available: it was used, cancelled or has expired. Ask for a new one."
          }
        }
      }
    },
    "data_failure_ios_enrollment_started": {
      "comment": "iPhone only: no Android text; for the owner to approve.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone may already have set up your vault. You can start over later."
          }
        }
      }
    },
    "data_failure_ios_enrollment_started_after": {
      "comment": "iPhone only: no Android text; for the owner to approve.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone may already have set up your vault. You can start over after %@."
          }
        }
      }
    },
    "data_failure_limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A limit was reached. Remove something first."
          }
        }
      }
    },
    "data_failure_local_state": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID could not read the keys it keeps on this phone for your vault. Nothing was deleted or changed. Try again, or restart the phone and open VettID again. If it stays like this, this phone cannot open your vault any more, and the way back is to erase VettID here and recover your vault."
          }
        }
      }
    },
    "data_failure_manifest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault software list could not be verified. Try again later."
          }
        }
      }
    },
    "data_failure_manifest_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list of vault releases could not be loaded, so your vault's software could not be checked. Nothing was sent to your vault. Check your connection and try again."
          }
        }
      }
    },
    "data_failure_network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
