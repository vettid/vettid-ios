    "calls_microphone_blocked_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't ask again. To make and answer calls, allow the microphone for VettID in Settings."
          }
        }
      }
    },
