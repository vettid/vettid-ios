      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is turned off for VettID"
          }
        }
      }
    },
    "calls_microphone_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID needs the microphone so %@ can hear you. It is used only during calls."
          }
        }
      }
    },
