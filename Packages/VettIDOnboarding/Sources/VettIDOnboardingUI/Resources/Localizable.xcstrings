    "unlock_signer_refused_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to recover your vault"
          }
        }
      }
    },
    "unlock_signer_refused_help_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First update VettID from where you installed it and try again: your PIN was not counted as wrong.\n\nIf that does not help, recover your vault. Start a recovery on the account site, install a current version of VettID (on this phone after removing this one, or on another phone) and choose \"I lost my phone: recover my vault\" on its first screen, then scan or type the recovery code. A recovery takes %@ and needs your PIN and your credential password.\n\nMoving your vault to a new phone directly is not possible while this phone cannot open it."
          }
        }
      }
    },
    "unlock_signer_refused_help_hide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        }
      }
    },
