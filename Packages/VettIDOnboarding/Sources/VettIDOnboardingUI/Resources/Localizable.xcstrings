      }
    },
    "unlock_recovery_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone started a recovery of this vault from the account site, so it is locked for this phone. If that was you on a new phone, let it finish there. If it was not you, cancel it now: unlocking here with your PIN cancels the recovery."
          }
        }
      }
    },
    "unlock_recovery_cancel": {
      "extractionState": "manual",
