          }
        }
      }
    },
    "onboarding_setup_type": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the code instead"
          }
        }
      }
    },
    "onboarding_setup_type_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your account's email address and the 8 characters shown under the QR code on the account site."
          }
        }
      }
    },
    "onboarding_setup_type_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
