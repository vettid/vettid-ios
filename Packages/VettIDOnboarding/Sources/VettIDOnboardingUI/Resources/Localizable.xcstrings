      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating your vault"
          }
        }
      }
    },
    "onboarding_welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VettID keeps your messages, connections and most important secrets in a vault that only you can open."
          }
        }
      }
    },
    "onboarding_welcome_point_keys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keys stay on this phone and in your vault's sealed enclave."
          }
        }
      }
    },
    "onboarding_welcome_point_member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
